[Unit]
Description=B3 portfolio dashboard - every 15 min during the session + after close

[Timer]
# Trading session: Mon-Fri 10:00-17:45, every 15 min
OnCalendar=Mon..Fri *-*-* 10..17:00/15:00
# After-close snapshot
OnCalendar=Mon..Fri *-*-* 18:05:00
# On boot, run any missed activation
Persistent=true

[Install]
WantedBy=timers.target
